APP_NAME=NeuroTrack
APP_ENV=e2e
# APP_KEY= (salin dari .env.e2e atau generate: php artisan key:generate)
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- E2E ---
# Password semua akun seed E2E
E2E_PASSWORD=Password123!
# Durasi QR (detik): test token-kedaluwarsa akan menunggu INTERVAL+6 detik
QR_INTERVAL_SECONDS=20
# Ikuti QR_INTERVAL_SECONDS agar config attendance.qr_step sinkron
ATTENDANCE_QR_STEP=20

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=neurotrack_e2e
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
