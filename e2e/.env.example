BASE_URL=http://localhost:3000
# Dijalankan sekali sebelum seluruh test: reset DB + seed data E2E (lihat README bagian "Kontrak seed")
E2E_RESET_CMD=pnpm prisma migrate reset --force --skip-generate
E2E_PASSWORD=Password123!
# Harus sama dengan interval QR di seed (PRD: 20-30 dtk). Dipakai untuk menguji token kedaluwarsa.
QR_INTERVAL_SECONDS=20
